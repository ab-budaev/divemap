# Переименуй в .env и поправь под себя

# Приложение
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=DEBUG

# Подключение к PostgreSQL (DSN для SQLAlchemy, драйвер psycopg).
# В контейнере имя хоста `db` — имя сервиса в docker compose.
DATABASE_URL=postgresql+psycopg://divemap:divemap@db:5432/divemap

# Учётные данные PostgreSQL (используются сервисом `db` в docker compose).
# Должны совпадать с теми, что в DATABASE_URL.
POSTGRES_USER=divemap
POSTGRES_PASSWORD=divemap
POSTGRES_DB=divemap

# Телеметрия: отключена по умолчанию для локальной разработки
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
